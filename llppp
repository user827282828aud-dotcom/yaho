local function makeDraggable(handle, targets)
    local dragging=false; local dragInput; local dragStart; local starts={}
    local function begin(input)
        dragging=true; dragStart=input.Position; starts={}
        for _,target in ipairs(targets) do starts[target]=target.Position end
        input.Changed:Connect(function()
            if input.UserInputState==Enum.UserInputState.End then dragging=false end
        end)
    end
    local function update(input)
        if not dragging then return end
        local delta=input.Position-dragStart
        for _,target in ipairs(targets) do
            local start=starts[target]
            target.Position=UDim2.new(start.X.Scale,start.X.Offset+delta.X,start.Y.Scale,start.Y.Offset+delta.Y)
        end
    end
    connect(handle.InputBegan,function(input)
        if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then begin(input) end
    end)
    connect(handle.InputChanged,function(input)
        if input.UserInputType==Enum.UserInputType.MouseMovement or input.UserInputType==Enum.UserInputType.Touch then dragInput=input end
    end)
    connect(UIS.InputChanged,function(input)
        if input==dragInput then update(input) end
    end)
end

