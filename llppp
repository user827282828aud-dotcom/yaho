            addHazard({Kind="circle",Owners=captureOwners(cf.Position,"Mushroom Battle Mage"),On=begin,Off=finish,Source=action,Predict=function(t)
                return cf+cf.LookVector*(length*math.clamp((t-begin)/math.max(duration,0.01),0,1)),nil,r
            end})
