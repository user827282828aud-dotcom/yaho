local function detourHazards(origin,goal,hazards,t)
    local cap=A.Config.DetourHazardCap or 12
    if #hazards<=cap then return hazards end

    -- Global A* only needs the hazards most relevant to the current corridor. The
    -- local dodge planner still evaluates every nearby threat, so this cap removes
    -- the combinatorial spike without making an omitted hitbox "safe".
    local midpoint=goal and origin:Lerp(goal,0.5) or origin
    local arrival=t+(goal and dist(origin,goal) or 0)/math.max(A.Config.WalkSpeed,1)
    local scored={}
    for _,h in ipairs(hazards) do
        local score=math.min(
            clearance(h,origin,t),
            clearance(h,midpoint,(t+arrival)*0.5),
            goal and clearance(h,goal,arrival) or math.huge
        )
        table.insert(scored,{H=h,Score=score})
    end
    table.sort(scored,function(a,b) return a.Score<b.Score end)
    local out={}
    for i=1,math.min(cap,#scored) do out[i]=scored[i].H end
    A.Stats.DetourHazards=#out
    return out
end

local function forwardDetour(origin,goal,hazards,t)
    A.Stats.Detouring=false
    if not goal or dist(origin,goal)<3 or #hazards==0 then A.Detour=nil;return goal end
    local routeHazards=detourHazards(origin,goal,hazards,t)
    if traversable(origin,goal) and hazardExposure(origin,goal,routeHazards,t,A.Config.WalkSpeed)==0 then A.Detour=nil;return goal end
    -- Plan beyond the obstructed local waypoint when the full approach is physically connected.
    if A.Goal and dist(origin,A.Goal)<90 and traversable(origin,A.Goal) then goal=A.Goal end
    local arrival=t+dist(origin,goal)/A.Config.WalkSpeed
    if hazardExposure(goal,goal,routeHazards,arrival,A.Config.WalkSpeed)>0 then
        local best,score
        for _,radius in ipairs({8,16}) do for i=0,7 do
            local p=projectGoal(goal+Vector3.new(math.cos(i*math.pi/4)*radius,0,math.sin(i*math.pi/4)*radius))
            if hazardExposure(p,p,routeHazards,t+dist(origin,p)/A.Config.WalkSpeed,A.Config.WalkSpeed)==0 then
                local cost=dist(origin,p)+dist(p,goal)*0.5
                if not score or cost<score then best,score=p,cost end
            end
        end end
        if best then goal=best end
    end
    if not A.DetourGoal or dist(goal,A.DetourGoal)>7 or t>(A.DetourAt or 0)+0.85 then
        local route,solved,expanded=gridRoute(origin,goal,routeHazards,t,110)
        A.Detour=route;A.DetourGoal=goal;A.DetourAt=t;A.Stats.DetourNodes=expanded;A.Stats.DetourComplete=solved
    end
    if A.Detour then
        -- String-pull the detour to its farthest currently clear point: no needless grid zig-zags.
        for i=#A.Detour,2,-1 do
            local p=A.Detour[i].Position
            if dist(origin,p)>2 and dist(origin,p)<40 and traversable(origin,p) and hazardExposure(origin,p,routeHazards,t,A.Config.WalkSpeed)==0 then
                A.Stats.Detouring=true;return p
            end
        end
    end
    A.Stats.Detouring=false;return goal
end
A._ForwardDetour=forwardDetour

-- Adaptive receding-horizon steering. Geometry is swept once per candidate direction,
-- then hazard positions are sampled cheaply along that already-validated motion prefix.
local function plannerBound(kind,size,radius)
    if kind=="circle" then return radius or 1 end
    size=size or Vector3.new(2,2,2)
    return math.sqrt(size.X*size.X+size.Z*size.Z)*0.5
end

local function pointSegmentDistance2D(p,a,b)
    local ap=flat(p-a);local ab=flat(b-a)
    local denom=ab:Dot(ab)
    if denom<0.0001 then return ap.Magnitude end
    local u=math.clamp(ap:Dot(ab)/denom,0,1)
    return (flat(a)+ab*u-flat(p)).Magnitude
end

local function preparedClearance(rec,frame,p,ft)
    if ft<rec.On or ft>rec.Off or not frame or not frame.CFrame then return math.huge end
    local cf=frame.CFrame
    local margin=rec.Margin
    -- Cheap circular broad phase before the more expensive box-space transform.
    if dist(p,cf.Position)>frame.Bound+margin+5 then return math.huge end
    if rec.Kind=="circle" then return dist(p,cf.Position)-(frame.Radius or 1)-margin end
    local size=frame.Size or Vector3.new(2,2,2)
    local q=cf:PointToObjectSpace(Vector3.new(p.X,cf.Position.Y,p.Z))
    local sx,sy,sz=size.X/2,size.Y/2,size.Z/2
    local dx,dy,dz=math.abs(q.X)-sx,math.abs(q.Y)-sy,math.abs(q.Z)-sz
    local outside=Vector3.new(math.max(dx,0),math.max(dy,0),math.max(dz,0)).Magnitude
    return outside+math.min(math.max(dx,dy,dz),0)-margin
end

local function preparePlannerHazards(origin,speed,t,hazards,samples,horizon)
    local prepared={}
    local reach=speed*horizon+(A.Config.HazardBroadphasePadding or 9)
    for _,h in ipairs(hazards) do
        if livingOwner(h) and (h.Off or math.huge)>=t and (h.On or -math.huge)<=t+horizon then
            local rec={H=h,Kind=h.Kind,Margin=A.Config.Margin+(h.ExtraMargin or 0),On=h.On or -math.huge,Off=h.Off or math.huge}
            local relevant=false
            if h.Predict then
                rec.Dynamic=true;rec.Frames={}
                local previous
                for k=0,samples do
                    local ft=t+horizon*k/samples
                    if ft>=rec.On and ft<=rec.Off then
                        local cf,size,radius=h.Predict(ft)
                        if cf then
                            local frame={CFrame=cf,Size=size,Radius=radius,Bound=plannerBound(h.Kind,size,radius)}
                            rec.Frames[k]=frame
                            if dist(origin,cf.Position)<=reach+frame.Bound+rec.Margin then relevant=true end
                            if previous and not relevant then
                                local swept=pointSegmentDistance2D(origin,previous.CFrame.Position,cf.Position)
                                if swept<=reach+math.max(previous.Bound,frame.Bound)+rec.Margin then relevant=true end
                            end
                            previous=frame
                        end
                    end
                end
            else
                local cf,size,radius=h.CFrame,h.Size,h.Radius
                if cf then
                    rec.Static={CFrame=cf,Size=size,Radius=radius,Bound=plannerBound(h.Kind,size,radius)}
                    relevant=dist(origin,cf.Position)<=reach+rec.Static.Bound+rec.Margin
                end
            end
            if relevant then table.insert(prepared,rec) end
        end
    end
    return prepared
end

-- Adaptive receding-horizon steering. Moving hazards are predicted once per time slice
-- and shared by every candidate direction. This removes the N hazards x N directions
-- x N samples Predict() explosion when a boss fills the room with warnings.
local function plan(origin,goal,speed,t,hazards)
    local desired=goal and unit(goal-origin) or ZERO

    local immediateDanger=false
    local nearDanger=false
    for _,h in ipairs(hazards) do
        local c=clearance(h,origin,t)
        if c<1.5 then immediateDanger=true;nearDanger=true;break
        elseif c<12 then nearDanger=true end
    end

    local dirCount=immediateDanger and (A.Config.EmergencyDirections or 24)
        or nearDanger and (A.Config.DangerDirections or 16)
        or (A.Config.SafeDirections or 10)
    local samples=immediateDanger and (A.Config.EmergencySamples or 14)
        or nearDanger and (A.Config.DangerSamples or 10)
        or (A.Config.SafeSamples or 6)

    local horizon=A.Config.Horizon
    local prepared=preparePlannerHazards(origin,speed,t,hazards,samples,horizon)
    A.Stats.RelevantHazards=#prepared

    local candidates={ZERO}
    if desired.Magnitude>0 then table.insert(candidates,desired) end
    for i=0,dirCount-1 do
        table.insert(candidates,Vector3.new(math.cos(i*2*math.pi/dirCount),0,math.sin(i*2*math.pi/dirCount)))
    end

    local best,bestScore,bestRisk,bestEnd=ZERO,math.huge,math.huge,origin
    for _,dir in ipairs(candidates) do
        local valid=true
        local maxTravel=0
        local endPos=origin

        if dir.Magnitude>0 then
            local targetDistance=speed*horizon
            if goal and desired.Magnitude>0 and dir:Dot(desired)>0.999 then
                targetDistance=math.min(targetDistance,dist(origin,goal))
            end
            local wanted=origin+dir*targetDistance
            local walk,safeEnd=traversable(origin,wanted)
            if walk and safeEnd then
                maxTravel=dist(origin,safeEnd)
                endPos=safeEnd
            else
                local found
                for frac=0.75,0.25,-0.25 do
                    local ok,prefix=traversable(origin,origin+dir*(targetDistance*frac))
                    if ok and prefix then found=prefix;break end
                end
                if found then maxTravel=dist(origin,found);endPos=found else valid=false end
            end
        end

        if valid then
            local exposure,near=0,0
            local function predictedPosition(dt)
                if dir.Magnitude==0 then return origin end
                return origin+dir*math.min(speed*dt,maxTravel)
            end

            for k=1,samples do
                local dt=horizon*k/samples
                local ft=t+dt
                local pos=predictedPosition(dt)
                for _,rec in ipairs(prepared) do
                    local frame=rec.Dynamic and rec.Frames[k] or rec.Static
                    local c=preparedClearance(rec,frame,pos,ft)
                    if c<0 then exposure+=(1+math.min(-c,15)*0.15)*(samples+1-k)
                    elseif c<5 then near+=(5-c)*0.025 end

                    -- Swept relative-motion protection still catches fast circular projectiles
                    -- between samples, but now reuses cached predictions instead of recomputing them.
                    if rec.Kind=="circle" and rec.Dynamic then
                        local a=rec.Frames[k-1];local b=rec.Frames[k]
                        if a and b then
                            local pa=predictedPosition(horizon*(k-1)/samples)
                            local pb=predictedPosition(dt)
                            local relative=flat(pa-a.CFrame.Position)
                            local delta=flat(pb-b.CFrame.Position)-relative
                            local alpha=delta:Dot(delta)>0.0001 and math.clamp(-relative:Dot(delta)/delta:Dot(delta),0,1) or 0
                            local swept=(relative+delta*alpha).Magnitude-math.max(a.Radius or rec.H.Radius or 1,b.Radius or rec.H.Radius or 1)-rec.Margin
                            if swept<0 and c>=0 then exposure+=(1+math.min(-swept,15)*0.15)*(samples+1-k) end
                        end
                    end
                end
            end

            local progress=goal and dist(endPos,goal) or dist(origin,endPos)*0.2
            local turn=(dir-A.Direction).Magnitude*1.5
            local score=exposure*10000+near*15+progress+turn
            if score<bestScore then best,bestScore,bestRisk,bestEnd=dir,score,exposure,endPos end
        end
    end
    A.Stats.PlannerMode=immediateDanger and "emergency" or nearDanger and "danger" or "cruise"
    return best,bestRisk,bestEnd,bestScore<math.huge
end
