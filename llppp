            local hit=clockFromEffect(data[2])
            addHazard({Kind="circle",OwnerName="Enchanted Forest Dragon",CFrame=data[1],Radius=26,On=hit-0.2,Off=hit+5.3,Source=action})
        end
    end)
    if not ok then A.LastSensorError=tostring(err) end
end) end

-- Persistent Golem objects stay dangerous between flashes. Bootstrap objects already in flight.
local golemObjects={}
local function observeGolem(v)
    if v.Name=="firstBossCrystal" or v.Name=="enchantedFirstBossFollowOrb" or v.Name=="firstBossSpinningRock" or v.Name=="firstBossCrystalDrop" then
        if not golemObjects[v] then golemObjects[v]={Last=now(),Owners=captureOwners(nil,"Crystal Golem")} end
    end
end
for _,v in ipairs(workspace:GetChildren()) do observeGolem(v) end
connect(workspace.ChildAdded,function(v) task.defer(function() if A.Alive and v.Parent then observeGolem(v) end end) end)
local function golemHazards(t,origin)
    local out={}
    for obj,record in pairs(golemObjects) do
        if not obj.Parent then golemObjects[obj]=nil
        elseif livingOwner(record) then
            local name=obj.Name
            if name=="firstBossCrystal" then
                local p=obj:FindFirstChild("precast")
                if p and p:IsA("BasePart") then
                    table.insert(out,{Kind="circle",Owners=record.Owners,CFrame=p.CFrame,Radius=math.max(p.Size.Y,p.Size.Z)/2,Source="Golem persistent crystal"})
                end
            elseif name=="enchantedFirstBossFollowOrb" then
                local p=obj:FindFirstChild("innerBall")
                if p then
                    local dt=t-record.Last
                    local velocity=record.Position and dt>0.02 and flat(p.Position-record.Position)/dt or ZERO
                    if velocity.Magnitude>90 then velocity=ZERO end
                    local cf=p.CFrame;local radius=math.max(p.Size.X,p.Size.Z)/2+1
                    local expanding=p.Size.X>8 or p.Size.Z>8
                    table.insert(out,{Kind="circle",Owners=record.Owners,Source=expanding and "Golem expanding dome" or "Golem chasing orb",Predict=function(ft)
                        return cf+velocity*math.clamp(ft-t,0,1),nil,expanding and 21 or radius
                    end})
                    record.Position=p.Position;record.Last=t
                end
            elseif name=="firstBossSpinningRock" then
                local p=obj:FindFirstChild("cylinder")
                if p then
                    local exact=false
                    for _,h in ipairs(A.Hazards) do if h.Source=="First Boss Shoot Spinning Orb" and h.Center and dist(h.Center,p.Position)<4 and (h.Off or 0)>t then exact=true;break end end
                    if not exact then
                        local cf,size=p.CFrame,p.Size
                        local yaw=math.atan2(cf.RightVector.Z,cf.RightVector.X)
                        local dt=t-record.Last
                        local omega=record.Yaw and dt>0.02 and math.atan2(math.sin(yaw-record.Yaw),math.cos(yaw-record.Yaw))/dt or 0
                        omega=math.clamp(omega,-math.rad(240),math.rad(240))
                        table.insert(out,{Kind="box",Owners=record.Owners,Source="Golem live sweeper",Predict=function(ft)
                            return cf*CFrame.Angles(0,-omega*math.clamp(ft-t,0,1),0),Vector3.new(size.X,5,math.max(size.Z,2))
                        end})
                        record.Yaw=yaw;record.Last=t
                    end
                end
            elseif name=="firstBossCrystalDrop" and obj:IsA("BasePart") then
                -- Recover the personal overhead mechanic if its initial event was missed.
                if dist(obj.Position,origin)<3 and obj.Position.Y>origin.Y-2 and obj.Position.Y<origin.Y+36 then
                    A.CrystalUntil=math.max(A.CrystalUntil or 0,t+0.3)
                end
            end
        end
    end
    return out
end
A._GolemHazards=golemHazards
A._TrackGolem=function(obj,owner) golemObjects[obj]={Last=now(),Owners={owner}} end

-- Legacy warning geometry. Excludes player spells, scenery and enemy bodies.
local visualParts={}
local ignoredNames={abilities=true,vfxPool=true,sfxPool=true,map=true,borders=true,
    firstBossSafeZones=true,firstBossBuildZones=true,firstBossSupplyModels=true}
local function isVisualCandidate(p)
    if not p:IsA("BasePart") then return false end
    local a=p.Parent
    while a and a~=workspace do
        if a.Name=="firstBossCrystal" or a.Name=="firstBossSpinningRock" or a.Name=="enchantedFirstBossFollowOrb" then return false end
        if ignoredNames[a.Name] or a.Name=="EFPathfinderVisuals" or (a:IsA("Model") and a:FindFirstChildOfClass("Humanoid")) then return false end
        a=a.Parent
    end
    local n=p.Name:lower()
    return n=="precast" or n=="hitbox" or n:find("damagezone",1,true)~=nil
        or (p.Parent==workspace and p:IsA("Part") and p.Material==Enum.Material.Neon and not p.CanCollide)
end
local function observe(p)
    if isVisualCandidate(p) then
        local v={Last=now(),Position=p.Position,Velocity=ZERO,Hazard={Source="visible marker"}}
        -- One predictor closure per observed part instead of one per part per planner tick.
        v.Predictor=function(ft)
            return v.CFrame+v.Velocity*math.clamp(ft-v.SampleTime,0,0.45),v.Size,v.Radius
        end
        visualParts[p]=v
    end
end
for _,p in ipairs(workspace:GetDescendants()) do observe(p) end
connect(workspace.DescendantAdded,function(p) task.defer(function() if A.Alive and p.Parent then observe(p) end end) end)
local visualHazardBuffer={}
local function visualHazards(t,origin)
    table.clear(visualHazardBuffer)
    local out=visualHazardBuffer
    for p,v in pairs(visualParts) do
        if not p.Parent then visualParts[p]=nil
        elseif dist(p.Position,origin)<260 then
            local dt=t-v.Last
            if dt>0.02 then
                local vel=flat(p.Position-v.Position)/dt
                v.Velocity=vel.Magnitude<180 and vel or ZERO; v.Position=p.Position; v.Last=t
            end
            -- Hidden dormant templates are not attacks. Explicit invisible damage boxes need a visible precast sibling.
            local visible=p.Transparency<0.96
            if not visible and p.Name:lower()=="hitbox" then
                local precast=p.Parent:FindFirstChild("precast") or p.Parent:FindFirstChild("preCast")
                visible=precast and precast:IsA("BasePart") and precast.Transparency<0.96
            end
            if visible and not v.Owners then v.Owners=captureOwners(p.Position) end
            if not visible then v.Owners=nil end
            if visible and livingOwner(v) then
                local cf,size=p.CFrame,p.Size
                local circle=p:IsA("Part") and (p.Shape==Enum.PartType.Cylinder or p.Shape==Enum.PartType.Ball)
                local radius=math.max(size.X,size.Y,size.Z)/2
                v.CFrame=cf;v.Size=size;v.Radius=radius;v.SampleTime=t
                local h=v.Hazard
                h.Kind=circle and "circle" or "box";h.Owners=v.Owners;h.CFrame=cf;h.Size=size;h.Radius=radius
                -- Static warnings do not need prediction at all. Moving ones reuse the persistent predictor above.
                h.Predict=v.Velocity.Magnitude>0.5 and v.Predictor or nil
                table.insert(out,h)
            end
        end
    end
    -- Player ring separation: leave a conservative buffer around other marked players.
    for _,other in ipairs(Players:GetPlayers()) do
        local c=other.Character; local root=c and c:FindFirstChild("HumanoidRootPart")
        if other~=player and root and root:FindFirstChild("thirdBossOverheadRingModel") then
            table.insert(out,{Kind="circle",Owners=captureOwners(nil,"Enchanted Forest Dragon"),CFrame=root.CFrame,Radius=13,Source="player ring"})
        end
    end
    return out
end

local enemyNames={["Mushroom Spearman"]=true,["Mushroom Wizard"]=true,["Poison Mushroom Mage"]=true,
    ["Mushroom Battle Mage"]=true,["Crystal Golem"]=true,["Ancient Enchanted Tree"]=true,
    ["Enchanted Forest Dragon"]=true,["Ancient Spirit"]=true}
local function refreshEnemies()
    table.clear(enemies)
    for _,v in ipairs(workspace:GetDescendants()) do
        if v:IsA("Humanoid") and enemyNames[v.Parent.Name] and v.Health>0 then
            local model=v.Parent; local root=model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
            if root then table.insert(enemies,{Model=model,Root=root,Humanoid=v}) end
        end
    end
end
local function activeBeam(root,name)
    if not root then return false end
    for _,p in ipairs(root:GetDescendants()) do if p:IsA("Beam") and p.Enabled and (not name or p.Name==name) then return true end end
    return false
end
local function chooseObjective(origin,t)
    if A.GoalOverride then return A.GoalOverride,"Custom destination",true end
    local golemAlive=false
    for _,e in ipairs(enemies) do if e.Model.Name=="Crystal Golem" and e.Humanoid.Parent and e.Humanoid.Health>0 then golemAlive=true;break end end
    if golemAlive and A.CrystalUntil and A.CrystalUntil>t then
        local zones=workspace:FindFirstChild("firstBossSafeZones"); local best,bd
        if zones then for _,p in ipairs(zones:GetChildren()) do
            if p:IsA("BasePart") and p.Transparency<0.96 then
                local d=dist(origin,p.Position); if not bd or d<bd then best,bd=p.Position,d end
            end
        end end
        if best then return best,"Crystal: enter green bubble",true end
        return nil,"Crystal warning: safe bubble not visible",true
    end
    local walls=workspace:FindFirstChild("firstBossBuildZones")
    local supplies=workspace:FindFirstChild("firstBossSupplyModels")
    local liveWalls={}
    if walls then for _,w in ipairs(walls:GetChildren()) do
        if activeBeam(w,"buildBeam") or activeBeam(w,"safeBeam") then table.insert(liveWalls,w) end
    end end
    if golemAlive and #liveWalls>0 then
        local choice,bd
        for _,w in ipairs(liveWalls) do
            local built=w:FindFirstChild("built");local safe=w:FindFirstChild("safeBox");local beam=w:FindFirstChild("beamPart")
            local p=built and built.Value and safe or beam
            if p then local d=dist(origin,p.Position)-(built and built.Value and 1000 or 0)
                if not bd or d<bd then choice,bd=w,d end
            end
        end
        if choice then
            local built=choice:FindFirstChild("built")
            if built and built.Value then return choice.safeBox.Position,"Slam: shelter behind wall",true end
            local char=player.Character
            if A.HasSupplies or (char and char:FindFirstChild("firstBossSupplyOverhead")) then
                return choice.beamPart.Position,"Slam: deliver rock",true
            end
            local best,sd
            if supplies then for _,s in ipairs(supplies:GetChildren()) do
                local main=s:FindFirstChild("mainPart")
                if main and activeBeam(s) then
                    local d=dist(origin,main.Position)+dist(main.Position,choice.beamPart.Position)
                    if not sd or d<sd then best,sd=main.Position,d end
                end
            end end
            return best,best and "Slam: collect rock" or "Slam: no active supplies visible",true
        end
    end
    local best,score
    for _,e in ipairs(enemies) do if e.Root.Parent and e.Humanoid.Health>0 then
        local d=dist(origin,e.Root.Position)
        if e.Model.Name=="Ancient Spirit" and d<100 then d-=25 end
        if A.Target==e.Model then d-=6 end
        if not score or d<score then best,score=e,d end
    end end
    if not best then A.Target=nil; return nil,"Waiting for enemies to appear",false end
    A.Target=best.Model
    local pos=best.Root.Position
    local delta=unit(origin-pos);if delta.Magnitude<0.1 then delta=Vector3.xAxis end
    local range=A.Config.Range
    -- Keep extra reaction room from Battle Mage orb shots; its projectile begins at the caster.
    if best.Model.Name=="Mushroom Battle Mage" then range=math.max(range,A.Config.BattleMageRange or 40) end
    -- Root-to-root distance for the Tree is large because its central moat is impassable.
    if best.Model.Name=="Ancient Enchanted Tree" then range=math.max(range,65) end
    return pos+delta*range,"Approaching "..best.Model.Name,false
end

local terrainCache={}
local function quant(v,step) return math.floor(v/step+0.5) end
local function terrainKey(a,b)
    local q=1.5
    return table.concat({quant(a.X,q),quant(a.Y,q),quant(a.Z,q),quant(b.X,q),quant(b.Y,q),quant(b.Z,q)},":")
end
local function clearTerrainCache()
    table.clear(terrainCache)
end

local geometry=RaycastParams.new()
geometry.FilterType=Enum.RaycastFilterType.Exclude
geometry.RespectCanCollide=true
geometry.IgnoreWater=false
local function refreshGeometry()
    local excluded={}
    for _,p in ipairs(Players:GetPlayers()) do if p.Character then table.insert(excluded,p.Character) end end
    for _,e in ipairs(enemies) do table.insert(excluded,e.Model) end
    for _,v in ipairs(workspace:GetChildren()) do if v.Name=="abilities" or v.Name=="EFPathfinderVisuals" then table.insert(excluded,v) end end
    geometry.FilterDescendantsInstances=excluded
    clearTerrainCache()
end

-- Use each equipped skill's real localEvent, exactly as the Q/E GUI buttons do.
-- Let the original skill scripts handle server requests, animations and internal locks.
local castAttemptAt=setmetatable({},{__mode="k"})
local pendingCasts=setmetatable({},{__mode="k"})
local lastCastAt=0
local function equippedSkills()
    local result={}
    for _,container in ipairs({player:FindFirstChild("Backpack"),player.Character}) do
        if container then for _,tool in ipairs(container:GetChildren()) do
            local slot=tool:FindFirstChild("abilitySlot")
            local event=tool:FindFirstChild("localEvent")
            if slot and (slot.Value=="q" or slot.Value=="e") and event and event:IsA("BindableEvent") then
                table.insert(result,{Tool=tool,Event=event,Slot=slot.Value,Buff=tool:FindFirstChild("buffPower")~=nil})
            end
        end end
    end
    table.sort(result,function(a,b) if a.Buff~=b.Buff then return a.Buff end return a.Slot<b.Slot end)
    return result
end
local function updateAim(hum,root)
    local target=A.Target
    local targetRoot=target and target.Parent and (target:FindFirstChild("HumanoidRootPart") or target.PrimaryPart)
    if not targetRoot or not A.Config.AutoSkills then
        if A.AimConstraint then A.AimConstraint.Enabled=false end
        hum.AutoRotate=A.PreviousAutoRotate~=false
        return
    end
    if not A.AimAttachment or A.AimAttachment.Parent~=root then
        if A.AimConstraint then A.AimConstraint:Destroy() end
        if A.AimAttachment then A.AimAttachment:Destroy() end
        local att=Instance.new("Attachment");att.Name="EFPathfinderAim";att.Parent=root
        local align=Instance.new("AlignOrientation");align.Name="EFPathfinderAim"
        align.Mode=Enum.OrientationAlignmentMode.OneAttachment;align.Attachment0=att
        align.MaxTorque=100000;align.MaxAngularVelocity=20;align.Responsiveness=35
        align.RigidityEnabled=false;align.Parent=root
        A.AimAttachment=att;A.AimConstraint=align
    end
    local d=unit(targetRoot.Position-root.Position)
    if d.Magnitude>0 then
        hum.AutoRotate=false;A.AimConstraint.Enabled=true
        A.AimConstraint.CFrame=CFrame.lookAt(ZERO,d)
    end
end
local function castSkills(t,hum,root)
    for tool,p in pairs(pendingCasts) do
        local cooldown=tool.Parent and tool:FindFirstChild("cooldown")
        if cooldown and cooldown.Value>0 then
            A.Stats.ConfirmedCasts+=1;A.LastSkill=tool.Name;pendingCasts[tool]=nil
        elseif t-p.Time>1.5 then pendingCasts[tool]=nil end
    end
    if not A.Config.AutoSkills or t-lastCastAt<0.18 then return end
    local target=A.Target
    local targetHum=target and target:FindFirstChildOfClass("Humanoid")
    local targetRoot=target and (target:FindFirstChild("HumanoidRootPart") or target.PrimaryPart)
    if not targetRoot or not targetHum or targetHum.Health<=0 then return end
    local busy=player.Character and player.Character:FindFirstChild("busyCasting")
    if busy and busy.Value then return end
    local distance=dist(root.Position,targetRoot.Position)
    if distance>A.Config.CastRange then return end
    local delta=targetRoot.Position-root.Position
    if delta.Magnitude>0.1 and workspace:Raycast(root.Position,delta,geometry) then return end
    for _,s in ipairs(equippedSkills()) do
        local cd=s.Tool:FindFirstChild("cooldown")
        if cd and cd.Value<=0 and t-(castAttemptAt[s.Tool] or -math.huge)>0.65 then
            local facing=flat(root.CFrame.LookVector):Dot(unit(delta))>0.9
            if s.Buff or facing then
                castAttemptAt[s.Tool]=t;lastCastAt=t;pendingCasts[s.Tool]={Time=t}
                A.Stats.CastRequests+=1;s.Event:Fire();return
            end
        end
    end
end
A._EquippedSkills=equippedSkills
local function rootLift()
    local _,h,r=charParts()
    return h and r and h.HipHeight>0 and h.HipHeight+r.Size.Y/2 or 3
end
local function grounded(p,referenceY)
    local lift=rootLift()
    local hit=workspace:Raycast(Vector3.new(p.X,referenceY-lift+3.5,p.Z),Vector3.new(0,-8.5,0),geometry)
    if not hit then return nil,"missing ground" end
    if hit.Material==Enum.Material.Water then return nil,"water" end
    if hit.Normal.Y<0.55 then return nil,"steep ground" end
    local rise=hit.Position.Y-(referenceY-lift)
    if rise>3.1 or rise< -4.5 then return nil,"step or drop" end
    return Vector3.new(p.X,hit.Position.Y+lift,p.Z)
end
local function traversable(from,to)
    local t=now()
    local key=terrainKey(from,to)
    local cached=terrainCache[key]
    if cached and t-cached.Time<(A.Config.TerrainCacheTTL or 0.18) then
        return cached.Ok,cached.Pos,cached.Reason
    end

    local delta=flat(to-from)
    local current,reason=grounded(from,from.Y)
    if not current then
        terrainCache[key]={Time=t,Ok=false,Pos=nil,Reason=reason}
        return false,nil,reason
    end
    if delta.Magnitude<0.05 then
        terrainCache[key]={Time=t,Ok=true,Pos=current}
        return true,current
    end

    -- Geometry only needs enough samples to catch narrow walls/ledges. 2.75 studs cuts
    -- duplicate ray/block casts substantially while remaining below the agent diameter.
    local count=math.max(1,math.ceil(delta.Magnitude/2.75))
    local width=A.Config.AgentRadius*2
    for i=1,count do
        local p=from+delta*(i/count)
        local nextRoot,why=grounded(p,current.Y)
        if not nextRoot then
            terrainCache[key]={Time=t,Ok=false,Pos=nil,Reason=why}
            return false,nil,why
        end
        local movement=nextRoot-current
        if movement.Magnitude>0.01 then
            local hit=workspace:Blockcast(CFrame.new(current+Vector3.new(0,0.2,0)),Vector3.new(width,3,width),movement,geometry)
            if hit then
                local whyHit="obstacle: "..hit.Instance.Name
                terrainCache[key]={Time=t,Ok=false,Pos=nil,Reason=whyHit}
                return false,nil,whyHit
            end
        end
        current=nextRoot
    end
    terrainCache[key]={Time=t,Ok=true,Pos=current}
    return true,current
end
local function projectGoal(p)
    local hit=workspace:Raycast(p+Vector3.new(0,8,0),Vector3.new(0,-72,0),geometry)
    if hit and hit.Normal.Y>=0.65 and hit.Material~=Enum.Material.Water then return hit.Position+Vector3.new(0,rootLift(),0) end
    return p
end
local function hazardExposure(from,to,hazards,t,speed)
    local length=dist(from,to);local steps=math.max(1,math.ceil(length/1.5));local cost=0
    for i=1,steps do
        local p=from:Lerp(to,i/steps);local arrival=t+length*i/steps/math.max(speed,1)
        for _,h in ipairs(hazards) do
            local c=clearance(h,p,arrival)
            if c<0 then cost+=1+math.min(-c,12)*0.15 end
        end
    end
    return cost/steps
end
-- A* over grounded walkable cells. Used for obstacle fallback and forward hazard detours.
-- Euclidean heuristic, positive travel costs, and corner checks on every edge.
local function gridRoute(origin,goal,hazards,t,maxNodes)
    local step=4;local speed=A.Config.WalkSpeed;local frontier={};local nodes={}
    local function push(n)
        table.insert(frontier,n);local i=#frontier
        while i>1 do local parent=math.floor(i/2);if frontier[parent].F<=n.F then break end;frontier[i]=frontier[parent];i=parent end
        frontier[i]=n
    end
    local function pop()
        local first=frontier[1];local last=table.remove(frontier)
        if #frontier>0 then
            local i=1
            while i*2<=#frontier do local child=i*2;if child<#frontier and frontier[child+1].F<frontier[child].F then child+=1 end
                if frontier[child].F>=last.F then break end;frontier[i]=frontier[child];i=child end
            frontier[i]=last
        end
        return first
    end
    local start={X=0,Z=0,Pos=origin,G=0,Length=0,F=dist(origin,goal)}
    nodes["0:0"]=start;push(start)
    local closest=start;local expansions=0;local solved=false;local finish
    local limit=math.min(160,dist(origin,goal)+36)
    while #frontier>0 and expansions<maxNodes do
        local n=pop()
        if not n.Closed and nodes[n.X..":"..n.Z]==n then
            n.Closed=true;expansions+=1
            if dist(n.Pos,goal)<dist(closest.Pos,goal) then closest=n end
            if dist(n.Pos,goal)<=step*1.5 then
                local walk,endPos=traversable(n.Pos,goal)
                if walk and hazardExposure(n.Pos,endPos,hazards,t+n.Length/speed,speed)==0 then
                    finish={Pos=endPos,Parent=n};solved=true;break
                end
            end
            for dx=-1,1 do for dz=-1,1 do if dx~=0 or dz~=0 then
                local x,z=n.X+dx,n.Z+dz;local key=x..":"..z
                local candidate=origin+Vector3.new(x*step,0,z*step)
                if dist(origin,candidate)<=limit then
                    local walk,p=traversable(n.Pos,candidate)
                    if walk then
                        local edge=(p-n.Pos).Magnitude
                        local exposure=hazardExposure(n.Pos,p,hazards,t+n.Length/speed,speed)
                        -- Do not route through an attack from a safe cell. Permit escaping an occupied origin.
                        local startDanger=false
                        if exposure>0 then for _,h in ipairs(hazards) do if clearance(h,n.Pos,t+n.Length/speed)<0 then startDanger=true;break end end end
                        if exposure==0 or startDanger then
                            local g=n.G+edge+exposure*1000
                            if not nodes[key] or g<nodes[key].G then
                                local nextNode={X=x,Z=z,Pos=p,G=g,Length=n.Length+edge,F=g+dist(p,goal),Parent=n}
                                nodes[key]=nextNode;push(nextNode)
                            end
                        end
                    end
                end
            end end end
        end
    end
    finish=finish or (dist(closest.Pos,goal)<dist(origin,goal)-3 and closest or nil)
    local route={}
    while finish do table.insert(route,1,{Position=finish.Pos,Action=Enum.PathWaypointAction.Walk});finish=finish.Parent end
    return route,solved,expansions
end
