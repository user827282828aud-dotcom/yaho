    local ok,err=pcall(function()
        if action=="First Boss Crystal Drop" then
            for _,c in pairs(data[1]) do if c==player.Character then A.CrystalUntil=clockFromEffect(data[3])+0.2 end end
        elseif action=="First Boss Player Pick Up Supplies" and data==player.Character then A.HasSupplies=true
        elseif action=="First Boss Remove Player Supplies" and data==player.Character then A.HasSupplies=false
        elseif action=="First Boss Remove All Player Supplies" then A.HasSupplies=false; A.WallChoice=nil
        elseif action=="First Boss Shoot Spinning Orb" or action=="Second Boss Spinning Laser" then
