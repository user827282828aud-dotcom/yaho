-- Retain caster references, not just their positions: a dead/despawned source cannot block movement.
local function livingOwner(h)
    if not h.Owners then return true end
    for _,hum in ipairs(h.Owners) do
        if hum.Parent and hum:IsDescendantOf(workspace) and hum.Health>0 then return true end
    end
    return false
end
local function captureOwners(position,preferredName,explicit)
    if explicit and typeof(explicit)=="Instance" then
        local hum=explicit:FindFirstChildOfClass("Humanoid")
        if hum then return {hum} end
    end
    local list={}
    local closest,closestDistance
    for _,e in ipairs(enemies) do
        if e.Root.Parent and e.Humanoid.Health>0 and (not preferredName or e.Model.Name==preferredName) then
            local d=position and dist(position,e.Root.Position) or 0
            if not closestDistance or d<closestDistance then closest,closestDistance=e,d end
        end
    end
    if not closest then
        -- A newly spawned caster can emit before the next one-second enemy refresh.
        local fallback={}
        for _,hum in ipairs(workspace:GetDescendants()) do
            if hum:IsA("Humanoid") and hum.Health>0 and hum.Parent:FindFirstChild("enemyStyle")
                and (not preferredName or hum.Parent.Name==preferredName) then table.insert(fallback,hum) end
        end
        return fallback
    end
    -- A projectile starting at the caster has an unambiguous nearby source.
    if position and closestDistance<8 then return {closest.Humanoid} end
    -- Targeted floor warnings omit the caster. Keep all potential sources from that encounter.
    local encounter=closest.Model.Parent
    for _,e in ipairs(enemies) do
        if e.Humanoid.Health>0 and e.Model.Parent==encounter and (not preferredName or e.Model.Name==preferredName) then table.insert(list,e.Humanoid) end
    end
    return list
end
A._HasLivingOwner=livingOwner

-- Signed distance to an expanded footprint. Negative is inside.
local function clearance(h,p,t)
    if not livingOwner(h) then return math.huge end
    if t<(h.On or -math.huge) or t>(h.Off or math.huge) then return math.huge end
    local cf,size,radius=h.CFrame,h.Size,h.Radius
    if h.Predict then cf,size,radius=h.Predict(t) end
    if not cf then return math.huge end
    local margin=A.Config.Margin+(h.ExtraMargin or 0)
    if h.Kind=="circle" then return dist(p,cf.Position)-(radius or 1)-margin end
    -- All planner positions are on the walking plane; attack volumes are ground footprints.
    local q=cf:PointToObjectSpace(Vector3.new(p.X,cf.Position.Y,p.Z))
    local sx,sy,sz=size.X/2,size.Y/2,size.Z/2
    -- Cylinders representing beams may have their long axis on local X.
    local dx,dy,dz=math.abs(q.X)-sx,math.abs(q.Y)-sy,math.abs(q.Z)-sz
    local outside=Vector3.new(math.max(dx,0),math.max(dy,0),math.max(dz,0)).Magnitude
    return outside+math.min(math.max(dx,dy,dz),0)-margin
end
local function addHazard(h)
    if not h.Owners then h.Owners=captureOwners(h.CFrame and h.CFrame.Position,h.OwnerName,h.Owner) end
    table.insert(A.Hazards,h); A.Stats.Warnings+=1
end
A._Clearance=clearance
A._AddHazard=addHazard
local function refreshHazards(t)
    for i=#A.Hazards,1,-1 do
        local h=A.Hazards[i]
        if not livingOwner(h) or (h.Off and h.Off<t) or (h.Part and not h.Part.Parent) then table.remove(A.Hazards,i) end
    end
end

-- Modern warning packets: shape, position and real activation time, without altering game handlers.
local sensorStatus="visual sensors"
pcall(function()
    local utility=RS:FindFirstChild("Utility")
    local bridge=require(utility:FindFirstChild("BridgeNet2"))
    local action=bridge.ReferenceIdentifier("action")
    local channel=bridge.ReferenceBridge("precastHitbox")
    local c=channel:Connect(function(packet)
        if not A.Alive then return end
        local kind=packet[action]
        if type(packet.startTime)~="number" or type(packet.delayUntilAttack)~="number" then return end
        local hit=clockFromServer(packet.startTime+packet.delayUntilAttack)
        if kind=="Circle" and typeof(packet.position)=="Vector3" and type(packet.radius)=="number" then
            addHazard({Kind="circle",CFrame=CFrame.new(packet.position),Radius=packet.radius,On=hit-0.15,Off=hit+0.45,Source="warning circle"})
        elseif kind=="Cube" and typeof(packet.cframe)=="CFrame" and typeof(packet.size)=="Vector3" then
            addHazard({Kind="box",CFrame=packet.cframe,Size=packet.size,On=hit-0.15,Off=hit+0.45,Source="warning line"})
        end
    end)
    table.insert(A.Connections,c); sensorStatus="timed warnings + visual sensors"
end)

-- Enchanted Forest effect packets expose deterministic motion for these attacks.
local function spinnerHazard(data,action)
    local center=data[2].Position
    local angle,total=data[8],data[4]
    local arrive,spin,finish=clockFromEffect(data[5]),clockFromEffect(data[6]),clockFromEffect(data[7])
    local length=action=="Second Boss Spinning Laser" and 450 or 50
    return {Kind="box",Center=center,Owner=data[1],On=arrive,Off=finish,Source=action,Predict=function(t)
        local grow=math.clamp((t-arrive)/math.max(spin-arrive,0.01),0,1)
        local rot=angle+total*math.clamp((t-spin)/math.max(finish-spin,0.01),0,1)
        return CFrame.new(center)*CFrame.Angles(0,math.rad(rot),0),Vector3.new(length*grow,5,2)
    end}
end
A._SpinnerHazard=spinnerHazard
local remote=RS:FindFirstChild("remotes") and RS.remotes:FindFirstChild("enchantedBossSpecficEvents")
if remote then connect(remote.OnClientEvent,function(action,data)
    if not A.Alive then return end
