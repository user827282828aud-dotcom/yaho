local function isLocalPlayerOwnedInstance(instance)
    if not instance then
        return false
    end

    local player =
        Players.LocalPlayer

    if not player then
        return false
    end

    local character =
        player.Character

    if character
        and (
            instance == character
            or instance:IsDescendantOf(
                character
            )
        )
    then
        return true
    end

    local backpack =
        player:FindFirstChildOfClass(
            "Backpack"
        )

    if backpack
        and (
            instance == backpack
            or instance:IsDescendantOf(
                backpack
            )
        )
    then
        return true
    end

    local tool =
        getAncestorTool(
            instance
        )

    if tool then
        if character
            and tool:IsDescendantOf(
                character
            )
        then
            return true
        end

        if backpack
            and tool:IsDescendantOf(
                backpack
            )
        then
            return true
        end

        if tool.Parent
            == player
        then
            return true
        end
    end

    return false
end

