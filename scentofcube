local function normalizeEnemyName(name)
    return string.lower(
        tostring(name or "")
    )
end

local function getEnemyThreatClass(enemy)
    if not enemy
        or not enemy.Model
    then
        return nil
    end

    local lower =
        normalizeEnemyName(
            enemy.Model.Name
        )

    if MELEE_ENEMY_NAMES[lower] then
        return "Melee"
    end

    if PROXIMITY_THREAT_NAMES[lower] then
        return "Proximity"
    end

    return nil
end

