        end)
    end
end)

function A:Destroy()
    if not self.Alive then return end
    self:SetRunning(false);self.Alive=false
    RunService:UnbindFromRenderStep("EFPathfinderMovement")
    for _,c in ipairs(self.Connections) do pcall(function() c:Disconnect() end) end
    if self.AimConstraint then self.AimConstraint:Destroy() end
    if self.AimAttachment then self.AimAttachment:Destroy() end
    gui:Destroy();visuals:Destroy()
    if env.EFPathfinder==self then env.EFPathfinder=nil end
end

RunService:BindToRenderStep("EFPathfinderMovement",Enum.RenderPriority.Input.Value+1,function()
    if not A.Running then return end
    local _,h,r=charParts()
    if h and r and h.Health>0 then h.WalkSpeed=A.Config.WalkSpeed;updateAim(h,r);h:Move(A.Direction,false) end
end)

local lastEnemies=0;local lastPlan=0;local lastVisual=0
connect(RunService.Heartbeat,function()
    if not A.Alive then return end
    
    -- Check for dungeon end states (victory/defeat)
    handleAutoReplay()
    
    local t=now();if t-lastPlan<A.Config.Tick then return end;lastPlan=t
    local began=t
    local ok,err=pcall(function()
        local _,hum,root=charParts()
        if t-lastEnemies>1.0 then refreshEnemies();refreshGeometry();lastEnemies=t end
        refreshHazards(t)
        if A.Running then
            if not hum or not root or hum.Health<=0 then A:SetRunning(false);A.Status="The vessel has fallen..."
            elseif not mapIsSupported() then A:SetRunning(false);A.Status="The path has shifted..."
            else
                local origin=root.Position
                local golem=golemHazards(t,origin)
                local goal,state,mandatory=chooseObjective(origin,t)
                A.Goal=goal
                local localGoal=goal and waypoint(origin,goal,t) or nil
                local hazards=visualHazards(t,origin)
                for _,h in ipairs(golem) do table.insert(hazards,h) end
                for _,h in ipairs(A.Hazards) do table.insert(hazards,h) end
                for _,e in ipairs(enemies) do if e.Root.Parent and e.Humanoid.Health>0 and dist(origin,e.Root.Position)<70 then
                    if e.Model.Name=="Mushroom Spearman" then
                        table.insert(hazards,{Kind="circle",CFrame=e.Root.CFrame,Radius=9,Source="melee range"})
                    elseif e.Model.Name=="Mushroom Battle Mage" then
                        table.insert(hazards,{Kind="circle",CFrame=e.Root.CFrame,Radius=A.Config.BattleMageKeepout or 28,Source="battle mage standoff"})
                    end
                end end
                localGoal=forwardDetour(origin,localGoal,hazards,t)
                local dir,risk,endpoint,hasCandidate=plan(origin,localGoal,hum.WalkSpeed,t,hazards)
                A.Direction=dir;A.Endpoint=endpoint;A.Stats.Hazards=#hazards;A.Stats.Risk=risk;A.Stats.Plans+=1
                A.Stats.LocalGoal=localGoal;A.Stats.HasCandidate=hasCandidate
                castSkills(t,hum,root)
                A.Status=state
                if A.Stats.Detouring and dir.Magnitude>0.1 then A.Status="Navigating through fate's obstacles..." end
                if not hasCandidate then A.Status="The way is blocked..."
                elseif risk>0 then A.Status=dir.Magnitude>0 and "Dodging the threads of doom..." or "Seeking sanctuary..."
                elseif goal and dist(origin,goal)<3 and dir.Magnitude<0.1 then A.Status=mandatory and state or "In position..."
                elseif goal and not localGoal then A.Status="Seeking the path..."
                elseif goal and dir.Magnitude<0.1 then A.Status=#hazards>0 and "Waiting for the stars to align..." or "Adjusting course..." end
                if mandatory and not goal then A.Direction=dir;A.Status=state end
                if not A.LastPosition or dist(origin,A.LastPosition)>1.5 or not goal or dist(origin,goal)<3 then A.LastPosition=origin;A.StalledAt=t end
                if goal and dist(origin,goal)>=3 and t-(A.StalledAt or t)>1.4 then
                    A.Route={};A.LastRouteAt=0;A.LocalRouteGoal=nil;A.NavReprobeAt=0
                    A.RouteGeneration=(A.RouteGeneration or 0)+1
                    requestPath(origin,goal,t)
                    A.Status="Recalculating destiny...";A.StalledAt=t
                end
            end
        end
        if t-lastVisual>0.20 then
            lastVisual=t
            for _,p in ipairs(dots) do p.Transparency=1 end
            if A.Running and A.Config.ShowPath and root then
                if A.Endpoint then for i=1,8 do dots[i].Position=root.Position:Lerp(A.Endpoint,i/8)-Vector3.new(0,2.3,0);dots[i].Transparency=0 end end
                for i=9,18 do local w=A.Route[A.RouteIndex+i-9];if w then dots[i].Position=w.Position+Vector3.new(0,0.4,0);dots[i].Transparency=0.3 end end
            end
            statusLabel.Text=A.Status
            statsLabel.Text=string.format("✦ %d/%d threats  •  %d casts  •  %.1f ms  •  %s",A.Stats.RelevantHazards or 0,A.Stats.Hazards or 0,A.Stats.ConfirmedCasts,A.Stats.LastPlanMs,A.Stats.PlannerMode or "cruise")
            toggleLabel.Text=A.Running and "⏸ Pause [P]" or "▶ Begin [P]"
            toggle.BackgroundColor3=A.Running and Color3.fromRGB(140,65,47) or Color3.fromRGB(40,30,70)
        end
    end)
    A.Stats.LastPlanMs=(now()-began)*1000
    if not ok then A:SetRunning(false);A.LastError=tostring(err);A.Status="Error: "..tostring(err);warn("EFPathfinder",err) end
end)

