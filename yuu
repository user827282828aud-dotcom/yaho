                        local dt=t-record.Last
                        local omega=record.Yaw and dt>0.02 and math.atan2(math.sin(yaw-record.Yaw),math.cos(yaw-record.Yaw))/dt or 0
                        omega=math.clamp(omega,-math.rad(240),math.rad(240))
                        table.insert(out,{Kind="box",Owners=record.Owners,Source="Golem live sweeper",Predict=function(ft)
                            return cf*CFrame.Angles(0,-omega*math.clamp(ft-t,0,1),0),Vector3.new(size.X,5,math.max(size.Z,2))
                        end})
