local pathBusy=false
local pathBusyAt=0

local function requestPath(origin,goal,t)
    if pathBusy then
        if t-pathBusyAt<1.75 then return end
        pathBusy=false
        A.PathError="Path request watchdog reset"
    end

    if A.LastRouteAt and t-A.LastRouteAt<0.35 then return end
    if A.Route[A.RouteIndex] and A.RouteGoal and dist(goal,A.RouteGoal)<8
        and t-(A.LastRouteAt or 0)<2.0 then return end

    A.LastRouteAt=t
    pathBusy=true
    pathBusyAt=t
    local generation=A.RouteGeneration or 0

    task.spawn(function()
        local path
        local ok,err=xpcall(function()
            path=PathfindingService:CreatePath({
                AgentRadius=A.Config.AgentRadius,
                AgentHeight=5,
                AgentCanJump=true,
                AgentCanClimb=true,
                WaypointSpacing=4
            })

            local projected=projectGoal(goal)
            local options={projected}

            for _,radius in ipairs({6,12,20}) do
                for i=0,3 do
                    local angle=i*math.pi/2
                    local candidate=goal+Vector3.new(math.cos(angle)*radius,0,math.sin(angle)*radius)
                    local hit=workspace:Raycast(candidate+Vector3.new(0,10,0),Vector3.new(0,-32,0),geometry)
                    if hit and hit.Normal.Y>=0.55 and hit.Material~=Enum.Material.Water then
                        table.insert(options,hit.Position+Vector3.new(0,rootLift(),0))
                    end
                end
            end

            local found
            for _,endpoint in ipairs(options) do
                if not A.Alive or generation~=(A.RouteGeneration or 0) then break end
                local computed=pcall(function() path:ComputeAsync(origin,endpoint) end)
                if computed and path.Status==Enum.PathStatus.Success then
                    local waypoints=path:GetWaypoints()
                    if #waypoints>=2 then
                        found=waypoints
                        A.Stats.RouteMethod="navigation mesh"
                        break
                    end
                end
            end

            if not found and A.Alive and generation==(A.RouteGeneration or 0) then
                local fallback,solved=gridRoute(origin,projected,{},now(),420)
                if #fallback>=2 then
                    found=fallback
                    A.Stats.RouteMethod=solved and "ground grid" or "ground grid progress"
                end
            end

            if not A.Alive or generation~=(A.RouteGeneration or 0) then return end

            if found then
                A.Route=found
                A.RouteIndex=math.min(2,#found)
                A.RouteGoal=goal
                A.PathError=nil
            else
                A.PathError="No global route; using local obstacle probe"
            end
        end,debug.traceback)

        pathBusy=false
        if path then pcall(function() path:Destroy() end) end

        if not ok then
            A.PathError=tostring(err)
            warn("EFPathfinder path request:",err)
        end
    end)
end
local function visibleWaypoint(origin,route,index)
    while route[index] and dist(origin,route[index].Position)<2.5 do index+=1 end
    local last=math.min(#route,index+6)
    for i=last,index,-1 do
        local p=route[i].Position
        if dist(origin,p)<38 and traversable(origin,p) then return p,i end
    end
    return nil,index
end

local function localObstacleProbe(origin,goal)
    if not goal then return nil end

    local forward=unit(goal-origin)
    if forward.Magnitude<0.1 then return nil end

    local best,bestScore=nil,math.huge

    local angles={0,15,-15,30,-30,45,-45,60,-60,75,-75,90,-90,120,-120}
    for _,length in ipairs({5,9,14,20}) do
        for _,deg in ipairs(angles) do
            local angle=math.rad(deg)
            local direction=Vector3.new(
                forward.X*math.cos(angle)-forward.Z*math.sin(angle),
                0,
                forward.X*math.sin(angle)+forward.Z*math.cos(angle)
            )
            local candidate=origin+direction*length
            local walk,endPos=traversable(origin,candidate)
            if walk and endPos then
                local progress=dist(endPos,goal)-dist(origin,goal)
                local score=progress+math.abs(deg)*0.025+length*0.002

                if direction:Dot(forward)<-0.15 then score+=18 end

                if score<bestScore then
                    bestScore=score
                    best=endPos
                end
            end
        end
    end

    return best
end

local function waypoint(origin,goal,t)
    if dist(origin,goal)<2 then return origin end

    if A.LocalRouteGoal and dist(origin,A.LocalRouteGoal)>2.5
        and A.LastGoal and dist(goal,A.LastGoal)<3
        and t<(A.NavReprobeAt or 0) then
        local walk=traversable(origin,A.LocalRouteGoal)
        if walk then return A.LocalRouteGoal end
    end

    if dist(origin,goal)<65 then
        local walk,endPos=traversable(origin,goal)
        if walk then
            A.LocalRouteGoal=endPos or goal
            A.LastGoal=goal
            A.NavReprobeAt=t+0.20
            return A.LocalRouteGoal
        end
    end

    requestPath(origin,goal,t)

    local p,index=visibleWaypoint(origin,A.Route,A.RouteIndex)
    A.RouteIndex=index
    if p then
        A.LocalRouteGoal=p
        A.LastGoal=goal
        A.NavReprobeAt=t+0.18
        return p
    end

    p=localObstacleProbe(origin,goal)
    if p then
        A.LocalRouteGoal=p
        A.LastGoal=goal
        A.NavReprobeAt=t+0.15
        A.Stats.RouteMethod="local obstacle probe"
        return p
    end

    local forward=unit(goal-origin)
    for _,length in ipairs({4,2}) do
        local candidate=origin+forward*math.min(length,dist(origin,goal))
        local walk,endPos=traversable(origin,candidate)
        if walk then
            p=endPos or candidate
            break
        end
    end

    A.LocalRouteGoal=p
    A.LastGoal=goal
    A.NavReprobeAt=t+0.12
    return p
end
