local function livingOwner(h)
    if not h.Owners then return true end
    for _,hum in ipairs(h.Owners) do
        if hum.Parent and hum:IsDescendantOf(workspace) and hum.Health>0 then return true end
    end
    return false
end
local function captureOwners(position,preferredName,explicit)
    if explicit and typeof(explicit)=="Instance" then
        local hum=explicit:FindFirstChildOfClass("Humanoid")
        if hum then return {hum} end
    end
    local list={}
    local closest,closestDistance
    for _,e in ipairs(enemies) do
        if e.Root.Parent and e.Humanoid.Health>0 and (not preferredName or e.Model.Name==preferredName) then
            local d=position and dist(position,e.Root.Position) or 0
            if not closestDistance or d<closestDistance then closest,closestDistance=e,d end
        end
    end
    if not closest then
        local fallback={}
        for _,hum in ipairs(workspace:GetDescendants()) do
            if hum:IsA("Humanoid") and hum.Health>0 and hum.Parent:FindFirstChild("enemyStyle")
                and (not preferredName or hum.Parent.Name==preferredName) then table.insert(fallback,hum) end
        end
        return fallback
    end
    if position and closestDistance<8 then return {closest.Humanoid} end
    local encounter=closest.Model.Parent
    for _,e in ipairs(enemies) do
        if e.Humanoid.Health>0 and e.Model.Parent==encounter and (not preferredName or e.Model.Name==preferredName) then table.insert(list,e.Humanoid) end
    end
    return list
end
A._HasLivingOwner=livingOwner

local function clearance(h,p,t)
    if not livingOwner(h) then return math.huge end
    if t<(h.On or -math.huge) or t>(h.Off or math.huge) then return math.huge end
    local cf,size,radius=h.CFrame,h.Size,h.Radius
    if h.Predict then cf,size,radius=h.Predict(t) end
    if not cf then return math.huge end
    local margin=A.Config.Margin+(h.ExtraMargin or 0)
    if h.Kind=="circle" then return dist(p,cf.Position)-(radius or 1)-margin end
    local q=cf:PointToObjectSpace(Vector3.new(p.X,cf.Position.Y,p.Z))
    local sx,sy,sz=size.X/2,size.Y/2,size.Z/2
    local dx,dy,dz=math.abs(q.X)-sx,math.abs(q.Y)-sy,math.abs(q.Z)-sz
    local outside=Vector3.new(math.max(dx,0),math.max(dy,0),math.max(dz,0)).Magnitude
    return outside+math.min(math.max(dx,dy,dz),0)-margin
end
local function addHazard(h)
    if not h.Owners then h.Owners=captureOwners(h.CFrame and h.CFrame.Position,h.OwnerName,h.Owner) end
    table.insert(A.Hazards,h); A.Stats.Warnings+=1
end
