local function rootLift()
    local _,h,r=charParts()
    return h and r and h.HipHeight>0 and h.HipHeight+r.Size.Y/2 or 3
end
local function grounded(p,referenceY)
    local lift=rootLift()
    local hit=workspace:Raycast(Vector3.new(p.X,referenceY-lift+3.5,p.Z),Vector3.new(0,-8.5,0),geometry)
    if not hit then return nil,"missing ground" end
    if hit.Material==Enum.Material.Water then return nil,"water" end
    if hit.Normal.Y<0.55 then return nil,"steep ground" end
    local rise=hit.Position.Y-(referenceY-lift)
    if rise>3.1 or rise< -4.5 then return nil,"step or drop" end
    return Vector3.new(p.X,hit.Position.Y+lift,p.Z)
end
local function traversable(from,to)
    local t=now()
    local key=terrainKey(from,to)
    local cached=terrainCache[key]
    if cached and t-cached.Time<(A.Config.TerrainCacheTTL or 0.18) then
        return cached.Ok,cached.Pos,cached.Reason
    end

    local delta=flat(to-from)
    local current,reason=grounded(from,from.Y)
    if not current then
        terrainCache[key]={Time=t,Ok=false,Pos=nil,Reason=reason}
        return false,nil,reason
    end
    if delta.Magnitude<0.05 then
        terrainCache[key]={Time=t,Ok=true,Pos=current}
        return true,current
    end

    local count=math.max(1,math.ceil(delta.Magnitude/2.75))
    local width=A.Config.AgentRadius*2
    for i=1,count do
        local p=from+delta*(i/count)
        local nextRoot,why=grounded(p,current.Y)
        if not nextRoot then
            terrainCache[key]={Time=t,Ok=false,Pos=nil,Reason=why}
            return false,nil,why
        end
        local movement=nextRoot-current
        if movement.Magnitude>0.01 then
            local hit=workspace:Blockcast(CFrame.new(current+Vector3.new(0,0.2,0)),Vector3.new(width,3,width),movement,geometry)
            if hit then
                local whyHit="obstacle: "..hit.Instance.Name
                terrainCache[key]={Time=t,Ok=false,Pos=nil,Reason=whyHit}
                return false,nil,whyHit
            end
        end
        current=nextRoot
    end
    terrainCache[key]={Time=t,Ok=true,Pos=current}
    return true,current
end
local function projectGoal(p)
    local hit=workspace:Raycast(p+Vector3.new(0,8,0),Vector3.new(0,-72,0),geometry)
    if hit and hit.Normal.Y>=0.65 and hit.Material~=Enum.Material.Water then return hit.Position+Vector3.new(0,rootLift(),0) end
    return p
end
local function hazardExposure(from,to,hazards,t,speed)
    local length=dist(from,to);local steps=math.max(1,math.ceil(length/1.5));local cost=0
    for i=1,steps do
        local p=from:Lerp(to,i/steps);local arrival=t+length*i/steps/math.max(speed,1)
        for _,h in ipairs(hazards) do
            local c=clearance(h,p,arrival)
            if c<0 then cost+=1+math.min(-c,12)*0.15 end
        end
    end
