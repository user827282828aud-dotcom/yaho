-- Enhanced map detection with dungeon state monitoring
local function mapIsSupported()
    if game.GameId~=9931749389 then return false end
    for _,v in ipairs(workspace:GetChildren()) do
        if v.Name=="dungeonName" and v:IsA("StringValue") and v.Value=="Enchanted Forest" then return true end
    end
    return false
end

-- Detect dungeon end states for auto-replay
local function checkDungeonResult()
    -- Check for victory screen/elements
    local playerGui = player:FindFirstChild("PlayerGui")
    if playerGui then
        -- Check for common victory/defeat UI elements
        for _, gui in ipairs(playerGui:GetDescendants()) do
            if gui:IsA("TextLabel") or gui:IsA("TextButton") then
                local text = gui.Text:lower()
                -- Victory indicators
                if text:find("victory") or text:find("cleared") or text:find("completed") or text:find("success") then
                    if not dungeonMonitor.victoryDetected then
                        dungeonMonitor.victoryDetected = true
                        A.LastDungeonResult = "victory"
                        A.Status = "Dungeon Cleared! The Fool's journey continues..."
                        return "victory"
                    end
                end
                -- Defeat indicators
                if text:find("defeated") or text:find("failed") or text:find("game over") or text:find("retry") then
                    if not dungeonMonitor.defeatDetected then
                        dungeonMonitor.defeatDetected = true
                        A.LastDungeonResult = "defeat"
                        A.Status = "Defeated... The Wheel of Fortune turns..."
                        return "defeat"
                    end
                end
            end
        end
    end
    
    -- Check if player was kicked from dungeon or returned to lobby
    local _, hum = charParts()
    if hum and hum.Health <= 0 then
        if A.Running then
            A.WasRunning = true
            A:SetRunning(false)
        end
    end
    
    return nil
end

-- Auto-replay logic
local function handleAutoReplay()
    if not A.Config.AutoReplay then return end
    
    local result = checkDungeonResult()
    if result and A.LastDungeonResult then
        -- Stop current running state
        if A.Running then
            A.WasRunning = true
            A:SetRunning(false)
        end
        
        -- Wait for respawn or dungeon restart, then auto-start
        task.delay(3, function()
            -- Reset detection flags
            dungeonMonitor.victoryDetected = false
            dungeonMonitor.defeatDetected = false
            
            -- Wait for character and dungeon to be ready
            local waitCount = 0
            while A.Alive and waitCount < 30 do
                local _, hum, root = charParts()
                if hum and hum.Health > 0 and root and mapIsSupported() then
                    task.wait(1.5)
                    if A.Config.AutoStart and A.WasRunning then
                        A:SetRunning(true)
                        A.Status = result == "victory" and "Auto-replaying after victory..." or "Auto-replaying after defeat..."
                    end
                    break
                end
                task.wait(0.5)
                waitCount = waitCount + 1
            end
        end)
    end
end

function A:SetRunning(value)
    if value and not mapIsSupported() then self.Status="Enchanted Forest required"; return false end
    local _,h=charParts()
    if value and (not h or h.Health<=0) then self.Status="Waiting for a living character"; return false end
    if value and h then
        if not self.Running then self.PreviousSpeed=h.WalkSpeed;self.PreviousAutoRotate=h.AutoRotate;self.SpeedHumanoid=h end
        h.WalkSpeed=self.Config.WalkSpeed
    elseif self.SpeedHumanoid then
        if self.SpeedHumanoid.Parent and self.SpeedHumanoid.WalkSpeed==self.Config.WalkSpeed then
            self.SpeedHumanoid.WalkSpeed=self.PreviousSpeed or 16
        end
        if self.SpeedHumanoid.Parent then self.SpeedHumanoid.AutoRotate=self.PreviousAutoRotate~=false end
        self.SpeedHumanoid=nil;self.PreviousSpeed=nil
    end
    if not value and self.AimConstraint then self.AimConstraint.Enabled=false end
    if not value and self.Running then self.WasRunning = true end
    self.Running=value; self.Direction=ZERO; self.Route={}; self.RouteIndex=1
    self.RouteGeneration=(self.RouteGeneration or 0)+1; self.LastRouteAt=0
    self.NavReprobeAt=0;self.StalledAt=now();self.LastPosition=nil;self.LastGoal=nil;self.Detour=nil;self.DetourGoal=nil
    if controls then if value then controls:Disable() else controls:Enable() end end
    if h then h:Move(ZERO,false) end
    self.Status=value and "The path unfolds before you..." or "Paused — Press P to begin"
    return true
end
