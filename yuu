local visualParts={}
local ignoredNames={abilities=true,vfxPool=true,sfxPool=true,map=true,borders=true,
    firstBossSafeZones=true,firstBossBuildZones=true,firstBossSupplyModels=true}
local function isVisualCandidate(p)
    if not p:IsA("BasePart") then return false end
    local a=p.Parent
    while a and a~=workspace do
        if a.Name=="firstBossCrystal" or a.Name=="firstBossSpinningRock" or a.Name=="enchantedFirstBossFollowOrb" then return false end
        if ignoredNames[a.Name] or a.Name=="EFPathfinderVisuals" or (a:IsA("Model") and a:FindFirstChildOfClass("Humanoid")) then return false end
        a=a.Parent
    end
    local n=p.Name:lower()
    return n=="precast" or n=="hitbox" or n:find("damagezone",1,true)~=nil
        or (p.Parent==workspace and p:IsA("Part") and p.Material==Enum.Material.Neon and not p.CanCollide)
end
local function observe(p)
    if isVisualCandidate(p) then
        local v={Last=now(),Position=p.Position,Velocity=ZERO,Hazard={Source="visible marker"}}
        v.Predictor=function(ft)
            return v.CFrame+v.Velocity*math.clamp(ft-v.SampleTime,0,0.45),v.Size,v.Radius
        end
        visualParts[p]=v
    end
end
for _,p in ipairs(workspace:GetDescendants()) do observe(p) end
connect(workspace.DescendantAdded,function(p) task.defer(function() if A.Alive and p.Parent then observe(p) end end) end)
local visualHazardBuffer={}
local function visualHazards(t,origin)
    table.clear(visualHazardBuffer)
    local out=visualHazardBuffer
    for p,v in pairs(visualParts) do
        if not p.Parent then visualParts[p]=nil
        elseif dist(p.Position,origin)<260 then
            local dt=t-v.Last
            if dt>0.02 then
                local vel=flat(p.Position-v.Position)/dt
                v.Velocity=vel.Magnitude<180 and vel or ZERO; v.Position=p.Position; v.Last=t
            end
            local visible=p.Transparency<0.96
            if not visible and p.Name:lower()=="hitbox" then
                local precast=p.Parent:FindFirstChild("precast") or p.Parent:FindFirstChild("preCast")
                visible=precast and precast:IsA("BasePart") and precast.Transparency<0.96
            end
            if visible and not v.Owners then v.Owners=captureOwners(p.Position) end
            if not visible then v.Owners=nil end
            if visible and livingOwner(v) then
                local cf,size=p.CFrame,p.Size
                local circle=p:IsA("Part") and (p.Shape==Enum.PartType.Cylinder or p.Shape==Enum.PartType.Ball)
                local radius=math.max(size.X,size.Y,size.Z)/2
                v.CFrame=cf;v.Size=size;v.Radius=radius;v.SampleTime=t
                local h=v.Hazard
                h.Kind=circle and "circle" or "box";h.Owners=v.Owners;h.CFrame=cf;h.Size=size;h.Radius=radius
                h.Predict=v.Velocity.Magnitude>0.5 and v.Predictor or nil
                table.insert(out,h)
            end
        end
    end
    for _,other in ipairs(Players:GetPlayers()) do
        local c=other.Character; local root=c and c:FindFirstChild("HumanoidRootPart")
        if other~=player and root and root:FindFirstChild("thirdBossOverheadRingModel") then
            table.insert(out,{Kind="circle",Owners=captureOwners(nil,"Enchanted Forest Dragon"),CFrame=root.CFrame,Radius=13,Source="player ring"})
        end
    end
    return out
end

