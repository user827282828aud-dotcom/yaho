local function chooseObjective(origin,t)
    if A.GoalOverride then return A.GoalOverride,"Custom destination",true end
    local golemAlive=false
    for _,e in ipairs(enemies) do if e.Model.Name=="Crystal Golem" and e.Humanoid.Parent and e.Humanoid.Health>0 then golemAlive=true;break end end
    if golemAlive and A.CrystalUntil and A.CrystalUntil>t then
        local zones=workspace:FindFirstChild("firstBossSafeZones"); local best,bd
        if zones then for _,p in ipairs(zones:GetChildren()) do
            if p:IsA("BasePart") and p.Transparency<0.96 then
                local d=dist(origin,p.Position); if not bd or d<bd then best,bd=p.Position,d end
            end
        end end
        if best then return best,"Crystal: enter green bubble",true end
        return nil,"Crystal warning: safe bubble not visible",true
    end
    local walls=workspace:FindFirstChild("firstBossBuildZones")
    local supplies=workspace:FindFirstChild("firstBossSupplyModels")
    local liveWalls={}
    if walls then for _,w in ipairs(walls:GetChildren()) do
        if activeBeam(w,"buildBeam") or activeBeam(w,"safeBeam") then table.insert(liveWalls,w) end
    end end
    if golemAlive and #liveWalls>0 then
        local choice,bd
        for _,w in ipairs(liveWalls) do
            local built=w:FindFirstChild("built");local safe=w:FindFirstChild("safeBox");local beam=w:FindFirstChild("beamPart")
            local p=built and built.Value and safe or beam
            if p then local d=dist(origin,p.Position)-(built and built.Value and 1000 or 0)
                if not bd or d<bd then choice,bd=w,d end
            end
        end
        if choice then
            local built=choice:FindFirstChild("built")
            if built and built.Value then return choice.safeBox.Position,"Slam: shelter behind wall",true end
            local char=player.Character
            if A.HasSupplies or (char and char:FindFirstChild("firstBossSupplyOverhead")) then
                return choice.beamPart.Position,"Slam: deliver rock",true
            end
            local best,sd
            if supplies then for _,s in ipairs(supplies:GetChildren()) do
                local main=s:FindFirstChild("mainPart")
                if main and activeBeam(s) then
                    local d=dist(origin,main.Position)+dist(main.Position,choice.beamPart.Position)
                    if not sd or d<sd then best,sd=main.Position,d end
                end
            end end
            return best,best and "Slam: collect rock" or "Slam: no active supplies visible",true
        end
    end
    local best,score
    for _,e in ipairs(enemies) do if e.Root.Parent and e.Humanoid.Health>0 then
        local d=dist(origin,e.Root.Position)
        if e.Model.Name=="Ancient Spirit" and d<100 then d-=25 end
        if A.Target==e.Model then d-=6 end
        if not score or d<score then best,score=e,d end
    end end
    if not best then A.Target=nil; return nil,"Waiting for enemies to appear",false end
