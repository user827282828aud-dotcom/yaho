local function detourHazards(origin,goal,hazards,t)
    local cap=A.Config.DetourHazardCap or 12
    if #hazards<=cap then return hazards end

    local midpoint=goal and origin:Lerp(goal,0.5) or origin
    local arrival=t+(goal and dist(origin,goal) or 0)/math.max(A.Config.WalkSpeed,1)
    local scored={}
    for _,h in ipairs(hazards) do
        local score=math.min(
            clearance(h,origin,t),
            clearance(h,midpoint,(t+arrival)*0.5),
            goal and clearance(h,goal,arrival) or math.huge
        )
        table.insert(scored,{H=h,Score=score})
    end
    table.sort(scored,function(a,b) return a.Score<b.Score end)
    local out={}
    for i=1,math.min(cap,#scored) do out[i]=scored[i].H end
    A.Stats.DetourHazards=#out
    return out
end

local function forwardDetour(origin,goal,hazards,t)
    A.Stats.Detouring=false
    if not goal or dist(origin,goal)<3 or #hazards==0 then A.Detour=nil;return goal end
    local routeHazards=detourHazards(origin,goal,hazards,t)
    if traversable(origin,goal) and hazardExposure(origin,goal,routeHazards,t,A.Config.WalkSpeed)==0 then A.Detour=nil;return goal end
    if A.Goal and dist(origin,A.Goal)<90 and traversable(origin,A.Goal) then goal=A.Goal end
    local arrival=t+dist(origin,goal)/A.Config.WalkSpeed
    if hazardExposure(goal,goal,routeHazards,arrival,A.Config.WalkSpeed)>0 then
        local best,score
        for _,radius in ipairs({8,16}) do for i=0,7 do
            local p=projectGoal(goal+Vector3.new(math.cos(i*math.pi/4)*radius,0,math.sin(i*math.pi/4)*radius))
            if hazardExposure(p,p,routeHazards,t+dist(origin,p)/A.Config.WalkSpeed,A.Config.WalkSpeed)==0 then
                local cost=dist(origin,p)+dist(p,goal)*0.5
                if not score or cost<score then best,score=p,cost end
            end
        end end
        if best then goal=best end
    end
    if not A.DetourGoal or dist(goal,A.DetourGoal)>7 or t>(A.DetourAt or 0)+0.85 then
        local route,solved,expanded=gridRoute(origin,goal,routeHazards,t,110)
        A.Detour=route;A.DetourGoal=goal;A.DetourAt=t;A.Stats.DetourNodes=expanded;A.Stats.DetourComplete=solved
    end
    if A.Detour then
        for i=#A.Detour,2,-1 do
            local p=A.Detour[i].Position
            if dist(origin,p)>2 and dist(origin,p)<40 and traversable(origin,p) and hazardExposure(origin,p,routeHazards,t,A.Config.WalkSpeed)==0 then
