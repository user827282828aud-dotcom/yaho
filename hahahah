local function spinnerHazard(data,action)
    local center=data[2].Position
    local angle,total=data[8],data[4]
    local arrive,spin,finish=clockFromEffect(data[5]),clockFromEffect(data[6]),clockFromEffect(data[7])
    local length=action=="Second Boss Spinning Laser" and 450 or 50
    return {Kind="box",Center=center,Owner=data[1],On=arrive,Off=finish,Source=action,Predict=function(t)
        local grow=math.clamp((t-arrive)/math.max(spin-arrive,0.01),0,1)
        local rot=angle+total*math.clamp((t-spin)/math.max(finish-spin,0.01),0,1)
        return CFrame.new(center)*CFrame.Angles(0,math.rad(rot),0),Vector3.new(length*grow,5,2)
    end}
end

