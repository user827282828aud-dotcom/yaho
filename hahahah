local function chooseObjective(origin,t)
    if A.GoalOverride then return A.GoalOverride,"Custom",true end
    
    local golemAlive=false
    for _,e in ipairs(enemies) do if e.Model.Name=="Crystal Golem" and e.Humanoid.Health>0 then golemAlive=true;break end end
    
    if golemAlive and A.CrystalUntil and A.CrystalUntil>t then
        local zones=workspace:FindFirstChild("firstBossSafeZones")
        if zones then for _,p in ipairs(zones:GetChildren()) do
            if p:IsA("BasePart") and p.Transparency<0.96 then return p.Position,"Crystal safe",true end
        end end
    end
    
    local best,score
    for _,e in ipairs(enemies) do if e.Root.Parent and e.Humanoid.Health>0 then
        local d=dist(origin,e.Root.Position)
        if e.Model.Name=="Ancient Spirit" and d<100 then d=d-25 end
        if A.Target==e.Model then d=d-6 end
        if not score or d<score then best,score=e,d end
    end end
    
    if not best then A.Target=nil; return nil,"No enemies",false end
    
    A.Target=best.Model
    local pos=best.Root.Position
    local delta=unit(origin-pos)
    if delta.Magnitude<0.1 then delta=Vector3.xAxis end
    local range=A.Config.Range
    if best.Model.Name=="Mushroom Battle Mage" then range=math.max(range,45) end
    if best.Model.Name=="Ancient Enchanted Tree" then range=math.max(range,70) end
    return pos+delta*range,"Approaching "..best.Model.Name,false
end

-- Pathfinding
local terrainCache={}
local function quant(v,step) return math.floor(v/step+0.5) end
local function terrainKey(a,b)
    local q=1.5
    return table.concat({quant(a.X,q),quant(a.Y,q),quant(a.Z,q),quant(b.X,q),quant(b.Y,q),quant(b.Z,q)},":")
end

local geometry=RaycastParams.new()
geometry.FilterType=Enum.RaycastFilterType.Exclude
geometry.RespectCanCollide=true

local function refreshGeometry()
    local excluded={}
    for _,p in ipairs(Players:GetPlayers()) do if p.Character then table.insert(excluded,p.Character) end end
    for _,e in ipairs(enemies) do table.insert(excluded,e.Model) end
    geometry.FilterDescendantsInstances=excluded
    table.clear(terrainCache)
end

local function grounded(p,referenceY)
    local _,h,r=charParts()
    local lift=h and r and h.HipHeight+r.Size.Y/2 or 3
    local hit=workspace:Raycast(Vector3.new(p.X,referenceY-lift+3.5,p.Z),Vector3.new(0,-8.5,0),geometry)
    if not hit then return nil end
    if hit.Material==Enum.Material.Water then return nil end
    if hit.Normal.Y<0.55 then return nil end
    local rise=hit.Position.Y-(referenceY-lift)
    if rise>3.1 or rise<-4.5 then return nil end
    return Vector3.new(p.X,hit.Position.Y+lift,p.Z)
end

local function traversable(from,to)
    local t=now()
    local key=terrainKey(from,to)
    local cached=terrainCache[key]
    if cached and t-cached.Time<(A.Config.TerrainCacheTTL or 0.18) then return cached.Ok,cached.Pos end
    
    local delta=flat(to-from)
    local current=grounded(from,from.Y)
    if not current then terrainCache[key]={Time=t,Ok=false}; return false,nil end
    if delta.Magnitude<0.05 then terrainCache[key]={Time=t,Ok=true,Pos=current}; return true,current end
    
    local count=math.max(1,math.ceil(delta.Magnitude/2.75))
    local width=A.Config.AgentRadius*2
    for i=1,count do
        local p=from+delta*(i/count)
        local nextRoot=grounded(p,current.Y)
        if not nextRoot then terrainCache[key]={Time=t,Ok=false}; return false,nil end
        local movement=nextRoot-current
        if movement.Magnitude>0.01 then
            local hit=workspace:Blockcast(CFrame.new(current+Vector3.new(0,0.2,0)),Vector3.new(width,3,width),movement,geometry)
            if hit then terrainCache[key]={Time=t,Ok=false}; return false,nil end
        end
        current=nextRoot
    end
    terrainCache[key]={Time=t,Ok=true,Pos=current}
    return true,current
end

local function hazardExposure(from,to,hazards,t,speed)
    local length=dist(from,to);local steps=math.max(1,math.ceil(length/1.5));local cost=0
    for i=1,steps do
        local p=from:Lerp(to,i/steps);local arrival=t+length*i/steps/math.max(speed,1)
        for _,h in ipairs(hazards) do
            local c=clearance(h,p,arrival)
            if c<0 then cost=cost+1+math.min(-c,12)*0.15 end
        end
    end
    return cost/steps
end

-- Grid route with hazards
local function gridRoute(origin,goal,hazards,t,maxNodes)
    local step=4;local speed=A.Config.WalkSpeed;local frontier={};local nodes={}
    local function push(n)
        table.insert(frontier,n);local i=#frontier
        while i>1 do local parent=math.floor(i/2);if frontier[parent].F<=n.F then break end;frontier[i]=frontier[parent];i=parent end
        frontier[i]=n
    end
    local function pop()
        local first=frontier[1];local last=table.remove(frontier)
        if #frontier>0 then
            local i=1
            while i*2<=#frontier do local child=i*2;if child<#frontier and frontier[child+1].F<frontier[child].F then child=child+1 end
                if frontier[child].F>=last.F then break end;frontier[i]=frontier[child];i=child end
            frontier[i]=last
        end
        return first
    end
    local start={X=0,Z=0,Pos=origin,G=0,Length=0,F=dist(origin,goal)}
    nodes["0:0"]=start;push(start)
    local closest=start;local expansions=0;local solved=false;local finish
    local limit=math.min(160,dist(origin,goal)+36)
    while #frontier>0 and expansions<maxNodes do
        local n=pop()
        if not n.Closed and nodes[n.X..":"..n.Z]==n then
            n.Closed=true;expansions=expansions+1
            if dist(n.Pos,goal)<dist(closest.Pos,goal) then closest=n end
            if dist(n.Pos,goal)<=step*1.5 then
                local walk,endPos=traversable(n.Pos,goal)
                if walk and hazardExposure(n.Pos,endPos,hazards,t+n.Length/speed,speed)==0 then
                    finish={Pos=endPos,Parent=n};solved=true;break
                end
            end
            for dx=-1,1 do for dz=-1,1 do if dx~=0 or dz~=0 then
                local x,z=n.X+dx,n.Z+dz;local key=x..":"..z
                local candidate=origin+Vector3.new(x*step,0,z*step)
                if dist(origin,candidate)<=limit then
                    local walk,p=traversable(n.Pos,candidate)
                    if walk then
                        local edge=(p-n.Pos).Magnitude
                        local exposure=hazardExposure(n.Pos,p,hazards,t+n.Length/speed,speed)
                        local startDanger=false
                        if exposure>0 then for _,h in ipairs(hazards) do if clearance(h,n.Pos,t+n.Length/speed)<0 then startDanger=true;break end end end
                        if exposure==0 or startDanger then
                            local g=n.G+edge+exposure*1000
                            if not nodes[key] or g<nodes[key].G then
                                local nextNode={X=x,Z=z,Pos=p,G=g,Length=n.Length+edge,F=g+dist(p,goal),Parent=n}
                                nodes[key]=nextNode;push(nextNode)
                            end
                        end
                    end
                end
            end end end
        end
    end
    finish=finish or (dist(closest.Pos,goal)<dist(origin,goal)-3 and closest or nil)
    local route={}
    while finish do table.insert(route,1,{Position=finish.Pos,Action=Enum.PathWaypointAction.Walk});finish=finish.Parent end
    return route,solved,expansions
end

-- Planner
local function plan(origin,goal,speed,t,hazards)
    local desired=goal and unit(goal-origin) or ZERO
    local immediateDanger=false
    local nearDanger=false
    for _,h in ipairs(hazards) do
        local c=clearance(h,origin,t)
        if c<1.5 then immediateDanger=true;nearDanger=true;break
        elseif c<12 then nearDanger=true end
    end
    
    local dirCount=immediateDanger and A.Config.EmergencyDirections or nearDanger and A.Config.DangerDirections or A.Config.SafeDirections
    local samples=immediateDanger and A.Config.EmergencySamples or nearDanger and A.Config.DangerSamples or A.Config.SafeSamples
    
    local candidates={ZERO}
    if desired.Magnitude>0 then table.insert(candidates,desired) end
    for i=0,dirCount-1 do
        table.insert(candidates,Vector3.new(math.cos(i*2*math.pi/dirCount),0,math.sin(i*2*math.pi/dirCount)))
    end
    
    local best,bestScore,bestRisk,bestEnd=ZERO,math.huge,math.huge,origin
    for _,dir in ipairs(candidates) do
        local valid=true;local maxTravel=0;local endPos=origin
        if dir.Magnitude>0 then
            local targetDistance=speed*A.Config.Horizon
            if goal and desired.Magnitude>0 and dir:Dot(desired)>0.999 then targetDistance=math.min(targetDistance,dist(origin,goal)) end
            local wanted=origin+dir*targetDistance
            local walk,safeEnd=traversable(origin,wanted)
            if walk and safeEnd then maxTravel=dist(origin,safeEnd);endPos=safeEnd else valid=false end
        end
        if valid then
            local exposure=0
            for k=1,samples do
                local dt=A.Config.Horizon*k/samples;local ft=t+dt
                local pos=origin+dir*math.min(speed*dt,maxTravel)
                for _,h in ipairs(hazards) do
                    local c=clearance(h,pos,ft)
                    if c<0 then exposure=exposure+(1+math.min(-c,15)*0.15)*(samples+1-k) end
                end
            end
            local progress=goal and dist(endPos,goal) or dist(origin,endPos)*0.2
            local turn=(dir-A.Direction).Magnitude*1.5
            local score=exposure*10000+progress+turn
            if score<bestScore then best,bestScore,bestRisk,bestEnd=dir,score,exposure,endPos end
        end
    end
    A.Stats.PlannerMode=immediateDanger and "emergency" or nearDanger and "danger" or "cruise"
    return best,bestRisk,bestEnd,bestScore<math.huge
end

-- Skills
local castAttemptAt={}
local pendingCasts={}
local lastCastAt=0
local function equippedSkills()
    local result={}
    for _,container in ipairs({player:FindFirstChild("Backpack"),player.Character}) do
        if container then for _,tool in ipairs(container:GetChildren()) do
            local slot=tool:FindFirstChild("abilitySlot")
            local event=tool:FindFirstChild("localEvent")
            if slot and (slot.Value=="q" or slot.Value=="e") and event and event:IsA("BindableEvent") then
                table.insert(result,{Tool=tool,Event=event,Slot=slot.Value,Buff=tool:FindFirstChild("buffPower")~=nil})
            end
        end end
    end
    table.sort(result,function(a,b) if a.Buff~=b.Buff then return a.Buff end return a.Slot<b.Slot end)
    return result
end

local function castSkills(t,hum,root)
    for tool,p in pairs(pendingCasts) do
        local cooldown=tool.Parent and tool:FindFirstChild("cooldown")
        if cooldown and cooldown.Value>0 then
            A.Stats.ConfirmedCasts+=1;pendingCasts[tool]=nil
        elseif t-p.Time>1.5 then pendingCasts[tool]=nil end
    end
    if not A.Config.AutoSkills or t-lastCastAt<0.18 then return end
    local target=A.Target
    local targetHum=target and target:FindFirstChildOfClass("Humanoid")
    local targetRoot=target and (target:FindFirstChild("HumanoidRootPart") or target.PrimaryPart)
    if not targetRoot or not targetHum or targetHum.Health<=0 then return end
    local busy=player.Character and player.Character:FindFirstChild("busyCasting")
    if busy and busy.Value then return end
    local distance=dist(root.Position,targetRoot.Position)
    if distance>A.Config.CastRange then return end
    local delta=targetRoot.Position-root.Position
    if delta.Magnitude>0.1 and workspace:Raycast(root.Position,delta,geometry) then return end
    for _,s in ipairs(equippedSkills()) do
        local cd=s.Tool:FindFirstChild("cooldown")
        if cd and cd.Value<=0 and t-(castAttemptAt[s.Tool] or -math.huge)>0.65 then
            local facing=flat(root.CFrame.LookVector):Dot(unit(delta))>0.9
            if s.Buff or facing then
                castAttemptAt[s.Tool]=t;lastCastAt=t;pendingCasts[s.Tool]={Time=t}
                A.Stats.CastRequests+=1;s.Event:Fire();return
            end
        end
    end
end

