local lastVisual=0

connect(RunService.Heartbeat, function()
    if not A.Alive then return end
    local t=now()
    
    -- Smooth UI update (no blink)
    if t-A.LastUIUpdate>0.2 then
        A.LastUIUpdate=t
        startBtn.Text=A.Running and "⏸ PAUSE" or "▶ START"
        startBtn.BackgroundColor3=A.Running and Color3.fromRGB(140,80,60) or Color3.fromRGB(40,70,90)
        rangeBtn.Text="RANGE: "..A.Config.Range
        skillsBtn.Text=A.Config.AutoSkills and "SKILLS: ON" or "SKILLS: OFF"
        skillsBtn.BackgroundColor3=A.Config.AutoSkills and Color3.fromRGB(40,70,90) or Color3.fromRGB(90,50,50)
        statusLabel.Text=A.Status
        statsLabel.Text=string.format("Range: %d | Skills: %s | Mode: %s | Hazards: %d", 
            A.Config.Range, 
            A.Config.AutoSkills and "ON" or "OFF",
            A.Stats.PlannerMode or "cruise",
            A.Stats.RelevantHazards or 0)
    end
    
    -- Pathfinding tick
    if t-lastPlan<A.Config.Tick then return end
    lastPlan=t
    
    local _,hum,root=charParts()
    if not hum or not root then return end
    
    if t-lastEnemies>1 then refreshEnemies();refreshGeometry();lastEnemies=t end
    
    if A.Running then
        if hum.Health<=0 then
            A:SetRunning(false)
            A.Status="Died - Auto-restarting..."
            return
        end
        
        local origin=root.Position
        local goal,state,mandatory=chooseObjective(origin,t)
        A.Goal=goal
        
        -- Collect all hazards
        refreshHazards(t)
        local allHazards={}
        for _,h in ipairs(visualHazards(t,origin)) do table.insert(allHazards,h) end
        for _,h in ipairs(golemHazards(t,origin)) do table.insert(allHazards,h) end
        for _,h in ipairs(A.Hazards) do table.insert(allHazards,h) end
        for _,e in ipairs(enemies) do if e.Root.Parent and e.Humanoid.Health>0 and dist(origin,e.Root.Position)<70 then
            if e.Model.Name=="Mushroom Spearman" then
                table.insert(allHazards,{Kind="circle",CFrame=e.Root.CFrame,Radius=9,Source="melee"})
            elseif e.Model.Name=="Mushroom Battle Mage" then
                table.insert(allHazards,{Kind="circle",CFrame=e.Root.CFrame,Radius=A.Config.BattleMageKeepout or 28,Source="mage"})
            end
        end end
        
        -- Plan with dodging
        local dir,risk,endpoint,hasPlan=plan(origin,goal,hum.WalkSpeed,t,allHazards)
        A.Direction=dir
        A.Stats.RelevantHazards=#allHazards
        A.Stats.Risk=risk
        
        if hasPlan then
            hum:Move(dir,false)
        else
            hum:Move(ZERO,false)
        end
        
        -- Cast skills
        castSkills(t,hum,root)
        A.Status=state
        if risk>0 then A.Status="Dodging attacks..." end
    else
        hum:Move(ZERO,false)
    end
    
    -- Update visual dots
    if t-lastVisual>0.2 then
        lastVisual=t
        for _,p in ipairs(dots) do p.Transparency=1 end
        if A.Running and A.Config.ShowPath and root then
            if A.Endpoint then for i=1,8 do dots[i].Position=root.Position:Lerp(A.Endpoint,i/8)-Vector3.new(0,2.3,0);dots[i].Transparency=0 end end
        end
    end
end)

